// 1C:Enterprise 8.3 — вставка ошибки в Supabase (Postgres) напрямую или через HTTP
// Вариант 1: напрямую через ODBC/Postgres (если 1С имеет доступ к БД Supabase)
// Вариант 2: через HTTP-сервис Supabase REST (рекомендуется — не открывать БД наружу)

// ——— Вариант 2: HTTP (вставить в общий модуль, вызывать при ошибке) ———
Процедура СообщитьОбОшибке(ИмяСобытия, Уровень, ОбъектМетаданных, Данные, Комментарий, База) Экспорт
    // Данные — Структура или Соответствие, будет сериализовано в JSON
    Настройки = Новый Структура("SUPABASE_URL, SERVICE_KEY", "https://xxx.supabase.co", "eyJhbG...");
    URL = Настройки.SUPABASE_URL + "/rest/v1/errors";
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Новый Структура("event_name,level,metadata_object,data,comment_text,base",
        ИмяСобытия, Уровень, ОбъектМетаданных, Данные, Комментарий, База));
    ТелоЗапроса = ЗаписьJSON.Закрыть();
    
    HTTP = Новый HTTPСоединение(СтрЗаменить(СтрЗаменить(URL, "https://", ""), "/rest/v1/errors", ""), 443, , , , 5, Новый ЗащищенноеСоединениеOpenSSL());
    Запрос = Новый HTTPЗапрос("/rest/v1/errors");
    Запрос.Заголовки.Вставить("apikey", Настройки.SERVICE_KEY);
    Запрос.Заголовки.Вставить("Authorization", "Bearer " + Настройки.SERVICE_KEY);
    Запрос.Заголовки.Вставить("Content-Type", "application/json");
    Запрос.Заголовки.Вставить("Prefer", "return=representation");
    Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
    
    Попытка
        Ответ = HTTP.ОтправитьДляОбработки(Запрос);
        Если Ответ.КодСостояния <> 201 Тогда
            ЗаписьЖурналаРегистрации("1c-monitor", УровеньЖурналаРегистрации.Ошибка, , ,
                "Supabase insert failed: " + Ответ.КодСостояния + " " + Ответ.ПолучитьТелоКакСтроку());
        КонецЕсли;
    Исключение
        ЗаписьЖурналаРегистрации("1c-monitor", УровеньЖурналаРегистрации.Ошибка, , ,
            "HTTP ошибка: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

