# Supabase (supabase start выдаст эти значения, или возьми из Dashboard)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Firebase (FCM) — один из вариантов
# Вариант A (рекомендуется): service account json (FCM HTTP v1)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}
# Вариант B (legacy, для теста): server key
FCM_SERVER_KEY=AAAA...

# Flutter dart-define прокидываются при запуске:
# flutter run --dart-define=SUPABASE_URL=$SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
